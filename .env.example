# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mbata_agent
DB_USER=mbata_user
DB_PASSWORD=change_me

# Auth / Sessions
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_INACTIVITY_TIMEOUT_MINUTES=30

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email (fill in when wiring up notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@mbata-agent.local

# AI
AI_PROVIDER_API_KEY=

# Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
